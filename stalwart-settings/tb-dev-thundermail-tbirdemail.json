[
    {
        "__comment": "Create the tbird.email domain",
        "@type": "upsert",
        "object": "Domain",
        "matchOn": [
            "name"
        ],
        "value": {
            "dom-tbird-email": {
                "name": "tbird.email",
                "description": "tbird.email domain",
                "isEnabled": true,
                "certificateManagement": {
                    "@type": "Manual"
                },
                "subAddressing": {
                    "@type": "Enabled"
                },
                "allowRelaying": false
            }
        }
    },
    {
        "__comment": "The variables below must be deployed **SERVER-SIDE**, not in the stalwart-cli execution environment.",
        "@type": "upsert",
        "object": "Certificate",
        "matchOn": [
            "certificate",
            "privateKey"
        ],
        "value": {
            "crt-tbird-email": {
                "certificate": {
                    "@type": "EnvironmentVariable",
                    "variableName": "SSL_TBIRD_EMAIL_CERTIFICATE"
                },
                "privateKey": {
                    "@type": "EnvironmentVariable",
                    "variableName": "SSL_TBIRD_EMAIL_PRIVATE_KEY"
                }
            }
        }
    },
    {
        "__comment": "SystemSettings is a singleton, so it cannot be upserted, only updated.",
        "@type": "update",
        "object": "SystemSettings",
        "value": {
            "defaultDomainId": "#dom-tbird-email",
            "defaultHostname": "mail.tbird.email",
            "services": {
                "caldav": {
                    "cleartext": false
                },
                "carddav": {
                    "cleartext": false
                },
                "imap": {
                    "cleartext": false
                },
                "jmap": {
                    "cleartext": false
                },
                "managesieve": {
                    "cleartext": false
                },
                "smtp": {
                    "cleartext": false
                },
                "webdav": {
                    "cleartext": false
                }
            },
            "proxyTrustedNetworks": {
                "10.120.0.0/16": true
            },
            "providerInfo": {}
        }
    },
    {
        "@type": "upsert",
        "object": "NetworkListener",
        "value": {
            "listen-http": {
                "name": "http",
                "bind": {
                    "[::]:8080": true
                },
                "protocol": "http",
                "useTls": true,
                "tlsImplicit": false
            }
        }
    },
    {
        "@type": "upsert",
        "object": "NetworkListener",
        "value": {
            "listen-https": {
                "name": "https",
                "bind": {
                    "[::]:443": true
                },
                "protocol": "http",
                "useTls": true,
                "tlsImplicit": true
            }
        }
    },
    {
        "@type": "upsert",
        "object": "NetworkListener",
        "value": {
            "listen-sieve": {
                "name": "sieve",
                "bind": {
                    "[::]:4190": true
                },
                "protocol": "manageSieve",
                "useTls": true,
                "tlsImplicit": false
            }
        }
    },
    {
        "@type": "upsert",
        "object": "NetworkListener",
        "value": {
            "listen-imaps": {
                "name": "imaps",
                "bind": {
                    "[::]:993": true
                },
                "protocol": "imap",
                "useTls": true,
                "tlsImplicit": true
            }
        }
    },
    {
        "@type": "upsert",
        "object": "NetworkListener",
        "value": {
            "listen-submissions": {
                "name": "smtp",
                "bind": {
                    "[::]:465": true
                },
                "protocol": "http",
                "useTls": true,
                "tlsImplicit": true
            }
        }
    },
    {
        "@type": "upsert",
        "object": "NetworkListener",
        "value": {
            "listen-smtp": {
                "name": "smtp",
                "bind": {
                    "[::]:25": true
                },
                "protocol": "smtp",
                "useTls": true,
                "tlsImplicit": false
            }
        }
    },
    {
        "@type": "destroy",
        "object": "NetworkListener",
        "value": {
            "name": "pop3s"
        }
    }
]
